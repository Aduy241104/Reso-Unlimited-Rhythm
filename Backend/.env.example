NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# DATABASE remains supported for backward compatibility.
MONGODB_URI=mongodb://127.0.0.1:27017/reso
DATABASE=
REDIS_URL=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
RESET_PASSWORD_PATH=/reset-password

JWT_SECRET=
GOOGLE_CLIENT_ID=

CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Reso
MAIL_FROM_EMAIL=
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_PASSWORD_TTL_MINUTES=15

FINGERPRINT_ENABLED=true
FINGERPRINT_AUTO_MODERATION=true
# Deprecated compatibility flag. A clean fingerprint never bypasses Admin review.
FINGERPRINT_AUTO_APPROVE=false
# Optional override. npm install provides Backend/tools/chromaprint/fpcalc(.exe).
FPCALC_PATH=
FINGERPRINT_PROCESS_TIMEOUT_MS=45000
FINGERPRINT_MAX_DOWNLOAD_BYTES=262144000
FINGERPRINT_ALLOWED_AUDIO_HOSTS=res.cloudinary.com
FINGERPRINT_CRON_SCHEDULE=*/5 * * * *
FINGERPRINT_REVIEW_THRESHOLD=0.72
FINGERPRINT_HIGH_THRESHOLD=0.88
FINGERPRINT_MIN_OVERLAP_RATIO=0.65
FINGERPRINT_ALIGNMENT_WINDOW=100
FINGERPRINT_MAX_CANDIDATES=500
ADMIN_AUDIO_REVIEW_MIN_SECONDS=15

# MusicBrainz metadata reference (never treated as legal copyright proof)
MUSICBRAINZ_USER_AGENT=Reso-Unlimited-Rhythm/1.0 (copyright-review@example.com)
MUSICBRAINZ_TIMEOUT_MS=8000
MUSICBRAINZ_CACHE_TTL_MS=21600000

# AcoustID audio fingerprint lookup (server-only; never expose the key to clients)
ACOUSTID_API_KEY=oY7XWpMgm3
ACOUSTID_ENABLED=true
ACOUSTID_MIN_SCORE=0.85
ACOUSTID_TIMEOUT_MS=10000

VNPAY_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/result
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURR_CODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_EXPIRE_MINUTES=15
CLIENT_PAYMENT_SUCCESS_URL=http://localhost:5173/payment/result
CLIENT_PAYMENT_FAILED_URL=http://localhost:5173/payment/result
PAYMENT_PENDING_TIMEOUT_MINUTES=15

ANALYTICS_TIMEZONE=Asia/Ho_Chi_Minh
CRON_TIMEZONE=Asia/Ho_Chi_Minh
LISTEN_EVENT_SYNC_BATCH_SIZE=500
LISTEN_EVENT_SYNC_CRON_SCHEDULE=*/5 * * * *
REVENUE_AGGREGATION_CRON=
ARTIST_REVENUE_SHARE_PERCENT=
SUBSCRIPTION_MAINTENANCE_CRON=
SUBSCRIPTION_MAINTENANCE_TIMEZONE=Asia/Ho_Chi_Minh
